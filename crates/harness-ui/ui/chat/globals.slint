// Chat and workspace view state of Phase 9.2 (spec docs/specs/harness/phase-9-parity.md §7). Rust (src/chat)
// owns every list here; Slint only renders it and reports input. Nothing in this global is a core fact.
import { PaletteRow, ChipRow, ChatImage, ToolPart, UsagePart, PlanBar, PlanLimit, PlanSimple, OutputRow, ChangeRow, PlanRow, SubagentRow, FleetGroup, BackgroundTaskRow, GroupRow, ScheduleRow, MdLink } from "./chat_types.slint";
export { PaletteRow, ChipRow, ChatImage, ToolPart, UsagePart, PlanBar, PlanLimit, PlanSimple, OutputRow, ChangeRow, PlanRow, SubagentRow, FleetGroup, BackgroundTaskRow, GroupRow, ScheduleRow, MdLink }

export global ChatUi {
    // ---- turns (R8 / R10 / R14) ----
    // Expand / collapse a tool card or thinking row (state lives in the Rust model so virtualised rows keep it).
    callback toggle-detail(int);
    callback toggle-group(int);
    // "edit" | "rewind" | "fork" | "retry" | "undo" | "reapply" | "copy-md" | "copy-csv" | "open" on a chat item id.
    callback turn-action(string, int);
    // Open a tool-card path (`path` or `path:line`, workspace-relative or absolute) in the editor.
    callback open-path(string);
    callback show-earlier();
    // Item id of the last assistant row (Retry only there); -1 = none.
    in property <int> last-assistant: -1;
    // ---- status panel and context meter ----
    in property <[PlanRow]> plan;
    in-out property <bool> plan-open: true;
    in property <bool> usage-known;
    in property <float> usage-ratio;
    in property <string> usage-text;
    in property <string> usage-cost;
    in property <string> worktree-branch;
    in property <string> worktree-path;
    in property <string> session-cost;
    // ---- subagents (§9.8) ----
    in property <[SubagentRow]> subagents;
    in property <int> subagents-running;
    // Of those, how many wait on an approval (Orchestra live legend "N waiting").
    in property <int> subagents-waiting;
    // Only the active ones (running / needs approval): the Orchestra live canvas hides finished subagents.
    in property <[SubagentRow]> subagents-active;
    in property <[FleetGroup]> fleet;
    in property <int> fleet-running;
    in property <int> fleet-waiting;
    in property <int> fleet-sessions;
    in property <int> fleet-height;
    // ---- background tasks (§9.17) ----
    in property <[BackgroundTaskRow]> background-tasks;
    in property <int> background-tasks-running;
    in property <bool> auto-compact: true;
    // Generation speed ("tok/s", src/speed.rs): the setting, and the live figure of the running turn ("" when
    // no text is arriving). `speed-tick` runs once a second while a turn runs so a stale figure goes away.
    in property <bool> show-speed: true;
    in property <string> speed;
    callback speed-tick();
    // Seconds the open session's running turn has been running (src/turn_clock.rs), -1 when unknown.
    callback turn-secs() -> int;
    in property <[OutputRow]> outputs;
    in property <[UsagePart]> usage-parts;
    in property <[PlanLimit]> plan-limits;
    in property <[PlanSimple]> plan-simple;
    in property <[PlanSimple]> plan-current;
    in property <[PlanLimit]> plan-active;
    in property <bool> agy-plan;
    in-out property <string> limit-open;
    pure public function usage-tone(tone: int) -> color {
        if tone == 0 { return #4a8af4; }
        if tone == 1 { return #e8743b; }
        if tone == 2 { return #3fb68b; }
        if tone == 3 { return #d9a53a; }
        if tone == 4 { return #9a9a9a; }
        if tone == 5 { return #7a7a7a; }
        if tone == 6 { return #5c5c5c; }
        return #3a3a3a;
    }
    in property <string> usage-used-text;
    in property <string> usage-buffer-text;
    in property <string> usage-free-text;
    in property <string> usage-free-auto-text;
    callback usage-action(string);
    in property <bool> codex-reset-busy;
    in property <string> codex-reset-message;
    in property <bool> codex-reset-error;
    in property <bool> codex-reset-retry;
    in property <bool> codex-reset-check;
    in-out property <bool> codex-reset-confirm-open;
    in-out property <bool> subagents-open: true;
    in-out property <string> subagent-expanded;
    // Right panel Subagents list: false shows only running / waiting subagents, true shows finished ones too.
    in-out property <bool> subagents-show-all: false;
    // Unix seconds, refreshed by the panel timer while a subagent runs (elapsed time).
    in property <int> now-s;
    // Parent of the open session when it is a subagent session ("" = top-level).
    in property <string> parent-id;
    in property <string> parent-title;
    // "open" (subagent id) | "back" (parent id) | "tick".
    callback subagent-action(string, string);
    in property <bool> has-earlier;
    callback load-earlier();
    // Stop button of a background task (§9.17).
    callback stop-background-task(string);
    public pure function estimate(start: int, steps: int) -> float {
        return 0.06 + 0.86 * ((start > 0 ? max(0, now-s - start) / 120 : 0) + steps / 10) / ((start > 0 ? max(0, now-s - start) / 120 : 0) + steps / 10 + 1);
    }
    public pure function elapsed(start: int, end: int) -> string {
        if start <= 0 {
            return "";
        }
        if (end > 0 ? end : now-s) - start < 60 {
            return max(0, (end > 0 ? end : now-s) - start) + "s";
        }
        return floor(((end > 0 ? end : now-s) - start) / 60) + "m " + mod((end > 0 ? end : now-s) - start, 60) + "s";
    }
    // ---- text dialog (rename, edit + resend, new group, deny with feedback, schedules) ----
    in-out property <bool> dialog-open;
    in property <string> dialog-kind;
    // Texts come from dialog-text-of(dialog-kind, …) so they follow the language.
    in-out property <string> dialog-text;
    in-out property <string> dialog-text2;
    in-out property <bool> dialog-check;
    in property <bool> dialog-multiline;
    in property <bool> dialog-destructive;
    // Confirmation only (rewind, delete): no text field.
    in property <bool> dialog-confirm-only;
    callback dialog-submit();
    // ---- sessions (R10 / R11) ----
    // "rename" | "pin" | "unpin" | "unread" | "fork" | "delete" | "group:<id>" | "ungroup" on a session id.
    callback session-action(string, string);
    in property <[GroupRow]> groups;
    // "new" | "rename" | "color:<c>" | "delete" | "up" | "down" | "toggle" on a group id; "view" re-renders.
    callback group-action(string, string);
    // Sidebar shows the ungrouped sessions as a projects tree instead of timeline sections (UI-local).
    in-out property <bool> by-project: true;
    // Drag a session onto a group (group id) or out of every group ("").
    callback drop-session(string, string);
    // ---- permission ----
    callback deny-feedback(int);
    // ---- schedules (R18) ----
    in-out property <bool> schedules-open;
    in property <bool> schedules-enabled;
    in property <[ScheduleRow]> schedules;
    // "enable" | "disable" | "new" | "toggle" | "run" | "delete" on a schedule id.
    callback schedule-action(string, string);
    // ---- composer extras ----
    callback attach-files();
    callback paste-image() -> bool;
    // Opens the whiteboard (-1) or annotates the image chip at that index (13A).
    callback annotate-chip(int);

    // ---- command center (Mod+K) ----
    in-out property <bool> palette-open;
    // "all" | "actions" | "sessions" | "files"
    in-out property <string> palette-scope: "all";
    in property <[PaletteRow]> palette-rows;
    in-out property <int> palette-index;
    callback palette-query(string, string);
    callback palette-run(int);
    // ↑ / ↓: Rust moves palette-index to the next runnable row (section labels are skipped).
    callback palette-step(int);

    // ---- find in session (Mod+F) ----
    in-out property <bool> find-open;
    in property <int> find-count;
    // 1-based position of the current match; 0 = no match.
    in property <int> find-current;
    // Chat item id and row of the current match (-1 = none); find-seq changes on every step so the list scrolls
    // again even when the row stays the same.
    in property <int> find-id: -1;
    in property <int> find-row: -1;
    in property <int> find-seq;
    callback find(string);
    callback find-step(int);
    callback find-close();

    // ---- composer ----
    in-out property <bool> mention-open;
    // "@" (files, sessions, agents) or "/" (commands).
    in property <string> mention-trigger;
    in property <[PaletteRow]> mention-rows;
    in-out property <int> mention-index;
    callback draft-edited(string);
    callback mention-pick(int);
    in property <[ChipRow]> chips;
    callback remove-chip(int);
    // An OS file drag is over the window (winit HoveredFile); cleared on drop or cancel.
    in property <bool> drop-hover;
    // -1 = older prompt, +1 = newer; returns true when it replaced the draft.
    callback history(int) -> bool;

    // ---- header / navigation ----
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> can-prev;
    in property <bool> can-next;
    in property <bool> has-session;
    // "back" | "forward" | "prev" | "next"
    callback nav(string);
    // "markdown" | "html"
    callback export(string);
    callback reveal();
    callback copy-session-id(string);

    // ---- feedback ----
    in property <string> toast;
    in-out property <bool> ctrl-held;
    callback copy(string);
    pure callback link-at([MdLink], int) -> string;
    // ---- selecting text across blocks (`chat::select`) ----
    // A selection that began in one text block is being dragged, or stands; the part of the window between
    // that block and the pointer (blocks in it select themselves whole).
    in property <bool> drag-on;
    in property <length> drag-lo;
    in property <length> drag-hi;
    // the block the drag began in has a selection: its top and bottom, and the top and bottom of the message
    // it belongs to (the selection never leaves that message)
    callback drag-begin(length, length, length, length);
    // the left button is held (the span follows the pointer only then; afterwards the selection stands)
    in property <bool> drag-held;
    // a block joined or left the selection: its message id, block index and list row, and its text
    callback drag-join(int, int, int, string);
    callback drag-part(int, int, int);
    // copy: the first block's text, the two ends of its selection (bytes), its message id, block and row
    callback drag-copy(string, int, int, int, int, int);
    callback dismiss-error();

    // Labels of the command-center actions that are not keymap commands.
    pure public function action-label(id: string) -> string {
        if id == "compactSession" { return "Compact the conversation (summarize it to free context)"; }
        if id == "toggleAutoCompact" { return ChatUi.auto-compact ? "Auto-compact is on: turn it off" : "Auto-compact is off: turn it on (compacts at 85% context)"; }
        if id == "exportMarkdown" { return @tr("Export conversation as Markdown"); }
        if id == "exportHtml" { return @tr("Export conversation as HTML"); }
        if id == "copySessionId" { return @tr("Copy session ID"); }
        if id == "revealWorkspace" { return @tr("Reveal workspace in file manager"); }
        if id == "archiveSession" { return @tr("Archive current session"); }
        if id == "renameSession" { return @tr("Rename session"); }
        if id == "forkSession" { return @tr("Fork session"); }
        if id == "scheduledPrompts" { return @tr("Scheduled prompts"); }
        if id == "attachFiles" { return @tr("Attach files"); }
        if id == "whiteboard" { return @tr("Whiteboard"); }
        if id == "pinSession" { return @tr("Pin session"); }
        if id == "filesRestored" { return @tr("Files restored"); }
        if id == "filesSkipped" { return @tr("Some files were skipped"); }
        if id == "scheduleStarted" { return @tr("Scheduled prompt started"); }
        if id == "pastedText" { return @tr("Pasted text"); }
        if id == "copied" { return @tr("Copied"); }
        if id == "exported" { return @tr("Exported to"); }
        if id == "editDraftConflict" { return @tr("Send or clear the current draft before editing a queued message."); }
        id
    }

    // Texts of the shared dialog per kind; part: "title" | "label" | "label2" | "check" | "confirm".
    pure public function dialog-text-of(kind: string, part: string) -> string {
        if kind == "rename" {
            if part == "title" { return @tr("Rename session"); }
            if part == "confirm" { return @tr("Rename"); }
        }
        if kind == "edit" {
            if part == "title" { return @tr("Edit message"); }
            if part == "label" { return @tr("The message and every later turn are replaced by the edited message."); }
            if part == "check" { return @tr("Also restore files changed by those turns"); }
            if part == "confirm" { return @tr("Send"); }
        }
        if kind == "rewind" {
            if part == "title" { return @tr("Rewind to here"); }
            if part == "label" { return @tr("Removes this message and every later turn. Its text goes back into the composer."); }
            if part == "check" { return @tr("Also restore files changed by those turns"); }
            if part == "confirm" { return @tr("Rewind"); }
        }
        if kind == "deny" {
            if part == "title" { return @tr("Deny with feedback"); }
            if part == "label" { return @tr("The tool call is denied and this message is sent to the agent."); }
            if part == "confirm" { return @tr("Deny and send"); }
        }
        if kind == "delete" {
            if part == "title" { return @tr("Delete session"); }
            if part == "label" { return @tr("The session and its history are deleted. This cannot be undone."); }
            if part == "confirm" { return @tr("Delete"); }
        }
        if kind == "new-group" {
            if part == "title" { return @tr("New group"); }
            if part == "confirm" { return @tr("Create"); }
        }
        if kind == "rename-group" {
            if part == "title" { return @tr("Rename group"); }
            if part == "confirm" { return @tr("Rename"); }
        }
        if kind == "delete-group" {
            if part == "title" { return @tr("Delete group"); }
            if part == "label" { return @tr("Its sessions move back to the session list."); }
            if part == "confirm" { return @tr("Delete"); }
        }
        if kind == "remove-project" {
            if part == "title" { return @tr("Remove workspace"); }
            if part == "label" { return @tr("All sessions of this workspace are archived and it leaves the sidebar. Restore them in Settings › Archived. Files on disk are not touched."); }
            if part == "confirm" { return @tr("Remove"); }
        }
        if kind == "new-schedule" {
            if part == "title" { return @tr("New schedule"); }
            if part == "label" { return @tr("Prompt sent on every run (to the open session, or to a new session when none is open)."); }
            if part == "label2" { return @tr("Every N minutes"); }
            if part == "confirm" { return @tr("Create"); }
        }
        ""
    }

    // Dot color of a session group (GroupColor id).
    pure public function group-color(c: string) -> color {
        if c == "red" { return #e5484d; }
        if c == "orange" { return #f76b15; }
        if c == "yellow" { return #e2a336; }
        if c == "green" { return #30a46c; }
        if c == "blue" { return #0090ff; }
        if c == "purple" { return #8e4ec6; }
        #8b8d98
    }
    // Command-center section label (row kind "header", id in title).
    pure public function section-label(id: string) -> string {
        if id == "recent" { return @tr("Recent"); }
        if id == "suggested" { return @tr("Suggested"); }
        if id == "panels" { return @tr("Panels"); }
        if id == "configure" { return @tr("Configure"); }
        @tr("Sessions")
    }
    pure public function scope-label(id: string) -> string {
        if id == "actions" { return @tr("Actions"); }
        if id == "sessions" { return @tr("Sessions"); }
        if id == "files" { return @tr("Files"); }
        @tr("All")
    }

    // Group label of a sidebar timeline header (src/chat `timeline_group`).
    pure public function group-label(id: string) -> string {
        if id == "pinned" { return @tr("Pinned"); }
        if id == "today" { return @tr("Today"); }
        if id == "yesterday" { return @tr("Yesterday"); }
        if id == "week" { return @tr("Previous 7 days"); }
        if id == "month" { return @tr("Previous 30 days"); }
        @tr("Older")
    }

    // Relative time of a session row: "now", "5m", "3h", "2d" (Rust passes unit + amount).
    pure public function ago(unit: string, n: int) -> string {
        if unit == "now" { return @tr("now"); }
        if unit == "m" { return @tr("{0}m", n); }
        if unit == "h" { return @tr("{0}h", n); }
        if unit == "d" { return @tr("{0}d", n); }
        @tr("{0}w", n)
    }
}
